## Benchmark suite for transfer
## Part of the Alya Language package ecosystem (https://github.com/alya-lang)

import "std/test"
import "../src/lib.alya" as pkg

function main()
    let runner = bench_runner("transfer Micro-Benchmarks")

    # Bench 1: URL Parsing — 50k iterations
    bench_start(runner, 50000)
    let i = 0
    while i < 50000
        pkg::parse_transfer_url("ftp://operator:secret@ftp.server.org:2121/backups/db.tar.gz")
        i += 1
    end
    bench_stop(runner, "parse_transfer_url 50k calls")

    # Bench 2: CRC-32 Checksum Calculation — 20k iterations
    let sample = "The quick brown fox jumps over the lazy dog"
    bench_start(runner, 20000)
    let j = 0
    while j < 20000
        pkg::crc32(sample)
        j += 1
    end
    bench_stop(runner, "crc32 20k calls")

    # Bench 3: Range Header Formatting & Parsing — 100k iterations
    bench_start(runner, 100000)
    let k = 0
    while k < 100000
        pkg::build_range_header(1048576, 2097151)
        pkg::parse_content_range("bytes 1048576-2097151/10485760")
        k += 1
    end
    bench_stop(runner, "range build+parse 100k calls")

    # Bench 4: Progress Bar Rendering — 50k iterations
    let p = pkg::new_progress(5242880, 10485760, 1048576)
    bench_start(runner, 50000)
    let m = 0
    while m < 50000
        p.render_bar(30)
        m += 1
    end
    bench_stop(runner, "render_bar 50k calls")

    # Bench 5: SFTP Packet Encoding — 50k iterations
    bench_start(runner, 50000)
    let s = 0
    while s < 50000
        pkg::sftp_build_read(101, "handle_id", 1024, 65536)
        s += 1
    end
    bench_stop(runner, "sftp_build_read 50k calls")

    # Bench 6: FTP PASV Coordinate Decoding — 50k iterations
    let pasv_line = "227 Entering Passive Mode (192,168,1,50,195,149)"
    bench_start(runner, 50000)
    let c = 0
    while c < 50000
        pkg::ftp_parse_pasv(pasv_line)
        c += 1
    end
    bench_stop(runner, "ftp_parse_pasv 50k calls")

    # Bench 7: Multipart Chunk Planning — 20k iterations
    bench_extras_chunk_planning(runner)

    bench_summary(runner)
end

@cfg(feature = "extras")
function bench_extras_chunk_planning(runner)
    bench_start(runner, 20000)
    let r = 0
    while r < 20000
        pkg::plan_multipart_chunks(104857600, 8)
        r += 1
    end
    bench_stop(runner, "plan_multipart_chunks 20k calls")
end

@cfg(not(feature = "extras"))
function bench_extras_chunk_planning(runner)
end

main()
