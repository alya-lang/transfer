## Test suite for transfer
## Part of the Alya Language package ecosystem (https://github.com/alya-lang)

import "std/test"
import "std/net" as net
import "../src/lib.alya" as pkg

# ───────────────────────────────────────────────────────────
# SFTP loopback fake server (in-memory transport, no sockets)
# ───────────────────────────────────────────────────────────

let t_reqs = []
let t_resps = []
let t_cursor = { "req": 0, "resp": 0 }
let t_files = {}
let t_handles = {}
let t_hseq = { "n": 1 }

function t_fake_send(pkt)
    t_reqs.push(pkt)
end

function t_u64(arr, off) -> int
    let v: int = 0
    let i: int = 0
    while i < 8
        v = v * 256 + arr[off + i]
        i += 1
    end
    return v
end

function t_fake_step()
    while t_cursor["req"] < len(t_reqs)
        let req = t_reqs[t_cursor["req"]]
        t_cursor["req"] = t_cursor["req"] + 1
        let ptype: int = req.packet_type
        let rid: int = req.request_id
        let wire = req.payload_bytes
        when ptype
            is 1
                t_resps.push(pkg::sftp_build_version(3))
            is 3
                let pd = pkg::decode_sftp_string_bytes(wire, 9)
                let path: string = pd["value"]
                let flags: int = pkg::decode_u32_bytes(wire, pd["next_offset"])
                if flags == 1 and t_files.has(path) == false
                    t_resps.push(pkg::sftp_build_status(rid, 2, "no such file"))
                else
                    if t_files.has(path) == false
                        t_files[path] = ""
                    end
                    if flags != 1
                        t_files[path] = ""
                    end
                    let h: string = "h" + str(t_hseq["n"])
                    t_hseq["n"] = t_hseq["n"] + 1
                    t_handles[h] = path
                    t_resps.push(pkg::sftp_build_handle(rid, h))
                end
            is 5
                let hd = pkg::decode_sftp_string_bytes(wire, 9)
                let off: int = t_u64(wire, hd["next_offset"])
                let ln: int = pkg::decode_u32_bytes(wire, hd["next_offset"] + 8)
                let path: string = t_handles[hd["value"]]
                let content: string = t_files[path]
                if off >= len(content)
                    t_resps.push(pkg::sftp_build_status(rid, 1, "EOF"))
                else
                    let end_idx: int = off + ln
                    if end_idx > len(content)
                        end_idx = len(content)
                    end
                    t_resps.push(pkg::sftp_build_data(rid, slice(content, off, end_idx)))
                end
            is 6
                let hd = pkg::decode_sftp_string_bytes(wire, 9)
                let off: int = t_u64(wire, hd["next_offset"])
                let dd = pkg::decode_sftp_string_bytes(wire, hd["next_offset"] + 8)
                let path: string = t_handles[hd["value"]]
                let content: string = t_files[path]
                let before: string = slice(content, 0, off)
                let after: string = ""
                if off + len(dd["value"]) < len(content)
                    after = slice(content, off + len(dd["value"]), len(content))
                end
                t_files[path] = before + dd["value"] + after
                t_resps.push(pkg::sftp_build_status(rid, 0, ""))
            is 4
                t_resps.push(pkg::sftp_build_status(rid, 0, ""))
            else
                t_resps.push(pkg::sftp_build_status(rid, 8, "unsupported"))
        end
    end
end

function t_fake_recv()
    t_fake_step()
    if t_cursor["resp"] >= len(t_resps)
        return null
    end
    let p = t_resps[t_cursor["resp"]]
    t_cursor["resp"] = t_cursor["resp"] + 1
    return p
end

function main()
    test_suite("transfer Test Suite")
    let r = runner_new()

    # ═══════════════════════════════════════════════════════════
    # 1. Protocol & Lifecycle Enumerations
    # ═══════════════════════════════════════════════════════════
    runner_assert_eq(r, pkg::TransferProtocol.Http, 0, "TransferProtocol.Http == 0")
    runner_assert_eq(r, pkg::TransferProtocol.Https, 1, "TransferProtocol.Https == 1")
    runner_assert_eq(r, pkg::TransferProtocol.Ftp, 2, "TransferProtocol.Ftp == 2")
    runner_assert_eq(r, pkg::TransferProtocol.Sftp, 3, "TransferProtocol.Sftp == 3")
    runner_assert_eq(r, pkg::TransferProtocol.File, 4, "TransferProtocol.File == 4")

    runner_assert_eq(r, pkg::TransferMode.Download, 0, "TransferMode.Download == 0")
    runner_assert_eq(r, pkg::TransferMode.Upload, 1, "TransferMode.Upload == 1")

    runner_assert_eq(r, pkg::TransferStatus.Idle, 0, "TransferStatus.Idle == 0")
    runner_assert_eq(r, pkg::TransferStatus.Running, 1, "TransferStatus.Running == 1")
    runner_assert_eq(r, pkg::TransferStatus.Paused, 2, "TransferStatus.Paused == 2")
    runner_assert_eq(r, pkg::TransferStatus.Completed, 3, "TransferStatus.Completed == 3")
    runner_assert_eq(r, pkg::TransferStatus.Failed, 4, "TransferStatus.Failed == 4")
    runner_assert_eq(r, pkg::TransferStatus.Canceled, 5, "TransferStatus.Canceled == 5")

    runner_assert_eq(r, pkg::ChecksumAlgo.None, 0, "ChecksumAlgo.None == 0")
    runner_assert_eq(r, pkg::ChecksumAlgo.Sha256, 1, "ChecksumAlgo.Sha256 == 1")
    runner_assert_eq(r, pkg::ChecksumAlgo.Md5, 2, "ChecksumAlgo.Md5 == 2")
    runner_assert_eq(r, pkg::ChecksumAlgo.Crc32, 3, "ChecksumAlgo.Crc32 == 3")

    # ═══════════════════════════════════════════════════════════
    # 2. Configuration & Model Construction
    # ═══════════════════════════════════════════════════════════
    let cfg = pkg::new_config(10000, 32768, 5, 1048576, 1)
    runner_assert_eq(r, cfg.timeout_ms, 10000, "cfg.timeout_ms is 10000")
    runner_assert_eq(r, cfg.chunk_size, 32768, "cfg.chunk_size is 32768")
    runner_assert_eq(r, cfg.max_retries, 5, "cfg.max_retries is 5")
    runner_assert_eq(r, cfg.rate_limit_bps, 1048576, "cfg.rate_limit_bps is 1 MB/s")
    runner_assert_eq(r, cfg.resumable, 1, "cfg.resumable is 1")
    runner_assert_eq(r, cfg.is_valid(), 1, "cfg.is_valid() returns 1")

    cfg.set_header("Authorization", "Bearer token123")
    runner_assert_str_eq(r, cfg.headers["Authorization"], "Bearer token123", "cfg.set_header works")

    cfg.set_auth("admin", "secret")
    runner_assert_str_eq(r, cfg.auth_user, "admin", "cfg.auth_user is admin")
    runner_assert_str_eq(r, cfg.auth_pass, "secret", "cfg.auth_pass is secret")

    cfg.set_checksum(pkg::ChecksumAlgo.Sha256, "abcdef")
    runner_assert_eq(r, cfg.checksum_algo, pkg::ChecksumAlgo.Sha256, "cfg.checksum_algo is set")
    runner_assert_str_eq(r, cfg.expected_checksum, "abcdef", "cfg.expected_checksum is set")

    let cfg_summary = cfg.summary()
    runner_assert_eq(r, len(cfg_summary) > 0, true, "cfg.summary() is non-empty")

    # ═══════════════════════════════════════════════════════════
    # 3. Progress Tracking & Metrics Calculation
    # ═══════════════════════════════════════════════════════════
    let prog = pkg::new_progress(5242880, 10485760, 1048576)
    runner_assert_eq(r, prog.bytes_transferred, 5242880, "prog.bytes_transferred is 5 MB")
    runner_assert_eq(r, prog.total_bytes, 10485760, "prog.total_bytes is 10 MB")
    runner_assert_eq(r, prog.percent, 50, "prog.percent is 50%")
    runner_assert_eq(r, prog.is_complete(), 0, "prog.is_complete() is 0 at 50%")

    let done_prog = pkg::make_progress(100, 100, 10, 10, 0)
    runner_assert_eq(r, done_prog.is_complete(), 1, "done_prog.is_complete() is 1 at 100%")

    let bar = prog.render_bar(20)
    runner_assert_eq(r, len(bar) > 0, true, "render_bar produces non-empty bar")

    runner_assert_str_eq(r, pkg::format_size(500), "500 B", "format_size B")
    runner_assert_str_eq(r, pkg::format_size(2048), "2 KB", "format_size KB")
    runner_assert_str_eq(r, pkg::format_size(5242880), "5 MB", "format_size MB")
    runner_assert_str_eq(r, pkg::format_size(2147483648), "2 GB", "format_size GB")

    runner_assert_str_eq(r, pkg::format_time(45), "00:45", "format_time seconds")
    runner_assert_str_eq(r, pkg::format_time(125), "02:05", "format_time minutes")
    runner_assert_str_eq(r, pkg::format_time(3665), "01:01:05", "format_time hours")

    let tracker = pkg::progress_tracker_new(1000, 0)
    let p_snap = pkg::progress_update(tracker, 500, 1000)
    runner_assert_eq(r, p_snap.percent, 50, "tracker computes 50% percent")
    runner_assert_eq(r, p_snap.speed_bps, 500, "tracker computes speed 500 bps")

    # ═══════════════════════════════════════════════════════════
    # 4. Bandwidth Throttling & Rate Limiting
    # ═══════════════════════════════════════════════════════════
    let throttle = pkg::throttle_new(1000, 0) # 1000 B/s cap
    let d0 = pkg::throttle_delay_ms(throttle, 500, 100)
    runner_assert_eq(r, d0, 0, "throttle within rate limit requires 0ms delay")

    let d1 = pkg::throttle_delay_ms(throttle, 1000, 200) # 1500 total in 200ms
    runner_assert_eq(r, d1 > 0, true, "throttle above limit calculates positive delay")

    # ═══════════════════════════════════════════════════════════
    # 5. Resumable Metadata Management
    # ═══════════════════════════════════════════════════════════
    let test_file = "temp_test_transfer.bin"
    write_file(test_file, "hello world partial content")

    let meta = pkg::make_resume_meta("http://example.com/file.bin", test_file, 100, 27, "etag-xyz", 16384)
    runner_assert_eq(r, meta.is_valid(), 1, "meta.is_valid() is 1")

    let saved = pkg::save_resume_meta(meta)
    runner_assert_eq(r, saved != 0, true, "save_resume_meta succeeds")

    let loaded = pkg::load_resume_meta(test_file)
    runner_assert_eq(r, loaded is not null, true, "load_resume_meta returns non-null")
    runner_assert_str_eq(r, loaded.url, "http://example.com/file.bin", "loaded meta url matches")
    runner_assert_eq(r, loaded.total_bytes, 100, "loaded meta total_bytes is 100")
    runner_assert_eq(r, loaded.transferred_bytes, 27, "loaded meta transferred_bytes is 27")
    runner_assert_str_eq(r, loaded.etag, "etag-xyz", "loaded meta etag matches")

    let resumable_ok = pkg::can_resume(test_file, "http://example.com/file.bin", 100)
    runner_assert_eq(r, resumable_ok, true, "can_resume returns true")

    pkg::clear_resume_meta(test_file)
    let after_clear = pkg::load_resume_meta(test_file)
    runner_assert_eq(r, after_clear is null, true, "clear_resume_meta deletes token file")
    remove_file(test_file)

    # ═══════════════════════════════════════════════════════════
    # 6. HTTP Range & Content-Range Headers
    # ═══════════════════════════════════════════════════════════
    let r_open = pkg::build_range_header(1024)
    runner_assert_str_eq(r, r_open, "bytes=1024-", "build_range_header open-ended")

    let r_closed = pkg::build_range_header(0, 4095)
    runner_assert_str_eq(r, r_closed, "bytes=0-4095", "build_range_header closed bounds")

    let cr_parsed = pkg::parse_content_range("bytes 500-999/5000")
    runner_assert_eq(r, cr_parsed["valid"], 1, "parse_content_range valid == 1")
    runner_assert_eq(r, cr_parsed["start"], 500, "parse_content_range start is 500")
    runner_assert_eq(r, cr_parsed["end"], 999, "parse_content_range end is 999")
    runner_assert_eq(r, cr_parsed["total"], 5000, "parse_content_range total is 5000")

    let h_map = {
        "Content-Length": "123456",
        "Accept-Ranges": "bytes",
        "ETag": "\"etag-123\""
    }
    runner_assert_eq(r, pkg::parse_content_length(h_map), 123456, "parse_content_length is 123456")
    runner_assert_eq(r, pkg::is_range_supported(h_map), true, "is_range_supported is true")
    runner_assert_str_eq(r, pkg::extract_etag(h_map), "etag-123", "extract_etag strips quotes")

    let raw_h = "HTTP/1.1 206 Partial Content\r\nContent-Range: bytes 0-499/1000\r\nContent-Length: 500\r\n"
    let parsed_h = pkg::parse_http_header_block(raw_h)
    runner_assert_eq(r, parsed_h["status_code"], 206, "parse_http_header_block status is 206")
    runner_assert_str_eq(r, parsed_h["headers"]["content-length"], "500", "header content-length is 500")

    # ═══════════════════════════════════════════════════════════
    # 7. URL Parsing & Normalization
    # ═══════════════════════════════════════════════════════════
    let u1 = pkg::parse_transfer_url("http://example.com:8080/path/file.zip?token=123")
    runner_assert_str_eq(r, u1["scheme"], "http", "u1 scheme is http")
    runner_assert_str_eq(r, u1["host"], "example.com", "u1 host is example.com")
    runner_assert_eq(r, u1["port"], 8080, "u1 port is 8080")
    runner_assert_str_eq(r, u1["path"], "/path/file.zip", "u1 path is /path/file.zip")
    runner_assert_str_eq(r, u1["query"], "token=123", "u1 query is token=123")

    let u_ftp = pkg::parse_transfer_url("ftp://user:pass@ftp.dlptest.com/archive.tar.gz")
    runner_assert_str_eq(r, u_ftp["scheme"], "ftp", "u_ftp scheme is ftp")
    runner_assert_eq(r, u_ftp["port"], 21, "u_ftp default port is 21")
    runner_assert_str_eq(r, u_ftp["user"], "user", "u_ftp user is user")
    runner_assert_str_eq(r, u_ftp["pass"], "pass", "u_ftp pass is pass")

    let u_sftp = pkg::parse_transfer_url("sftp://storage.internal/data.bin")
    runner_assert_str_eq(r, u_sftp["scheme"], "sftp", "u_sftp scheme is sftp")
    runner_assert_eq(r, u_sftp["port"], 22, "u_sftp default port is 22")

    runner_assert_str_eq(r, pkg::extract_url_filename("http://example.com/downloads/setup.exe"), "setup.exe", "extract_url_filename")

    # ═══════════════════════════════════════════════════════════
    # 8. Cryptographic & Data Integrity Checksums
    # ═══════════════════════════════════════════════════════════
    # CRC-32 golden vectors
    runner_assert_str_eq(r, pkg::crc32(""), "00000000", "CRC-32 empty string")
    runner_assert_str_eq(r, pkg::crc32("123456789"), "cbf43926", "CRC-32 standard 123456789")
    runner_assert_str_eq(r, pkg::crc32("The quick brown fox jumps over the lazy dog"), "414fa337", "CRC-32 fox")

    # MD5 golden vectors
    runner_assert_str_eq(r, pkg::md5(""), "d41d8cd98f00b204e9800998ecf8427e", "MD5 empty string")
    runner_assert_str_eq(r, pkg::md5("hello"), "5d41402abc4b2a76b9719d911017c592", "MD5 hello")

    # SHA-256 golden vectors
    runner_assert_str_eq(r, pkg::sha256(""), "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855", "SHA-256 empty string")
    runner_assert_str_eq(r, pkg::sha256("hello"), "2cf24dba5fb0a30e26e83b2ac5b9e29e1b161e5c1fa7425e73043362938b9824", "SHA-256 hello")

    # File checksum verification
    let sum_file = "temp_checksum_test.txt"
    write_file(sum_file, "hello")
    runner_assert_eq(r, pkg::verify_checksum(sum_file, "2cf24dba5fb0a30e26e83b2ac5b9e29e1b161e5c1fa7425e73043362938b9824", pkg::ChecksumAlgo.Sha256), 1, "verify_checksum SHA-256 matches")
    runner_assert_eq(r, pkg::verify_checksum(sum_file, "5d41402abc4b2a76b9719d911017c592", pkg::ChecksumAlgo.Md5), 1, "verify_checksum MD5 matches")
    remove_file(sum_file)

    # ═══════════════════════════════════════════════════════════
    # 9. FTP Protocol & PASV Decoding
    # ═══════════════════════════════════════════════════════════
    let ftp_resp = pkg::ftp_parse_response("220 Welcome to FTP Server")
    runner_assert_eq(r, ftp_resp.code, 220, "ftp_parse_response code is 220")
    runner_assert_str_eq(r, ftp_resp.message, "Welcome to FTP Server", "ftp_parse_response message")
    runner_assert_eq(r, ftp_resp.is_preliminary(), 0, "ftp_resp.is_preliminary() == 0")
    runner_assert_eq(r, ftp_resp.is_success(), 1, "ftp_resp.is_success() == 1")

    let pasv_line = "227 Entering Passive Mode (192,168,1,50,195,149)"
    let pasv = pkg::ftp_parse_pasv(pasv_line)
    runner_assert_eq(r, pasv["valid"], 1, "ftp_parse_pasv valid == 1")
    runner_assert_str_eq(r, pasv["ip"], "192.168.1.50", "ftp_parse_pasv ip is 192.168.1.50")
    runner_assert_eq(r, pasv["port"], 50069, "ftp_parse_pasv port is 50069 ((195*256)+149)")

    runner_assert_str_eq(r, pkg::ftp_format_command("USER", "test"), "USER test\r\n", "ftp_format_command")

    # ═══════════════════════════════════════════════════════════
    # 10. SFTP Binary Packet Framing (v3)
    # ═══════════════════════════════════════════════════════════
    let u32_bytes = pkg::encode_u32_bytes(305419896) # 0x12345678
    runner_assert_eq(r, pkg::decode_u32_bytes(u32_bytes), 305419896, "u32 big-endian encode/decode roundtrip")

    let sftp_init = pkg::sftp_build_init(3)
    runner_assert_eq(r, sftp_init.packet_type, pkg::SftpType.Init, "sftp_build_init packet_type is Init")
    runner_assert_eq(r, len(sftp_init.payload_bytes), 9, "sftp_build_init wire length is 9 bytes")

    let sftp_open = pkg::sftp_build_open(101, "/data/logs.txt", pkg::SftpOpenFlags.Read)
    runner_assert_eq(r, sftp_open.packet_type, pkg::SftpType.Open, "sftp_build_open packet_type is Open")
    runner_assert_eq(r, sftp_open.request_id, 101, "sftp_build_open request_id is 101")

    let sftp_read = pkg::sftp_build_read(102, "handle-1", 1024, 4096)
    runner_assert_eq(r, sftp_read.packet_type, pkg::SftpType.Read, "sftp_build_read packet_type is Read")

    let sftp_write = pkg::sftp_build_write(103, "handle-1", 2048, "binary payload")
    runner_assert_eq(r, sftp_write.packet_type, pkg::SftpType.Write, "sftp_build_write packet_type is Write")

    let sftp_close = pkg::sftp_build_close(104, "handle-1")
    runner_assert_eq(r, sftp_close.packet_type, pkg::SftpType.Close, "sftp_build_close packet_type is Close")

    let parsed_packet = pkg::sftp_parse_packet(sftp_close.payload_bytes)
    runner_assert_eq(r, parsed_packet.packet_type, pkg::SftpType.Close, "sftp_parse_packet parses type Close")
    runner_assert_eq(r, parsed_packet.request_id, 104, "sftp_parse_packet parses request_id 104")

    # ═══════════════════════════════════════════════════════════
    # 11. Fluent TransferBuilder API
    # ═══════════════════════════════════════════════════════════
    let dl_builder = pkg::download("http://example.com/movie.mp4", "movie.mp4")
    .timeout(20000)
    .chunk_size(65536)
    .rate_limit(5242880)
    .resumable(1)
    .overwrite(1)
    .auth("user", "pass")
    .header("X-Custom", "Val")
    .verify_sha256("1234567890abcdef")

    runner_assert_eq(r, dl_builder.mode, pkg::TransferMode.Download, "dl_builder mode is Download")
    runner_assert_eq(r, dl_builder.config.timeout_ms, 20000, "dl_builder timeout is 20000")
    runner_assert_eq(r, dl_builder.config.chunk_size, 65536, "dl_builder chunk_size is 65536")
    runner_assert_eq(r, dl_builder.config.rate_limit_bps, 5242880, "dl_builder rate_limit is 5 MB/s")
    runner_assert_str_eq(r, dl_builder.config.headers["X-Custom"], "Val", "dl_builder header is set")
    runner_assert_str_eq(r, dl_builder.config.expected_checksum, "1234567890abcdef", "dl_builder expected checksum is set")

    let up_builder = pkg::upload("http://example.com/api/upload", "report.pdf")
    .timeout(30000)
    .rate_limit(1048576)

    runner_assert_eq(r, up_builder.mode, pkg::TransferMode.Upload, "up_builder mode is Upload")
    runner_assert_eq(r, up_builder.config.timeout_ms, 30000, "up_builder timeout is 30000")

    # ═══════════════════════════════════════════════════════════
    # 12. Feature-Gated Extras (Multipart Chunk Planning)
    # ═══════════════════════════════════════════════════════════
    let chunks = pkg::plan_multipart_chunks(1000, 4)
    runner_assert_eq(r, len(chunks), 4, "plan_multipart_chunks creates 4 slices")
    runner_assert_eq(r, chunks[0]["start"], 0, "chunk 0 start is 0")
    runner_assert_eq(r, chunks[0]["end"], 249, "chunk 0 end is 249")
    runner_assert_eq(r, chunks[1]["start"], 250, "chunk 1 start is 250")
    runner_assert_eq(r, chunks[3]["end"], 999, "chunk 3 end is 999")

    let banner = pkg::format_transfer_banner("Download Task Started")
    runner_assert_eq(r, len(banner) > 0, true, "format_transfer_banner is non-empty")

    # ═══════════════════════════════════════════════════════════
    # 13. Redirect Resolution & Policy
    # ═══════════════════════════════════════════════════════════
    runner_assert_str_eq(r, pkg::resolve_redirect_url("http://a.com/o", "https://b.com/n"), "https://b.com/n", "absolute location passes through")
    runner_assert_str_eq(r, pkg::resolve_redirect_url("http://a.com:8080/d", "//other.com/x"), "http://other.com/x", "scheme-relative location")
    runner_assert_str_eq(r, pkg::resolve_redirect_url("https://a.com:8443/a/b", "/root"), "https://a.com:8443/root", "root-relative keeps non-default port")
    runner_assert_str_eq(r, pkg::resolve_redirect_url("http://h:80/a", "/b"), "http://h/b", "default port elided")
    runner_assert_str_eq(r, pkg::resolve_redirect_url("http://h/dir/page", "sub"), "http://h/dir/sub", "relative location merges")
    runner_assert_str_eq(r, pkg::resolve_redirect_url("http://h/dir/", ""), "", "empty location resolves to empty")
    runner_assert_eq(r, pkg::redirect_crosses_host("http://a.com/x", "http://a.com/y"), 0, "same host is not cross-host")
    runner_assert_eq(r, pkg::redirect_crosses_host("http://a.com/x", "http://b.com/y"), 1, "other host is cross-host")
    runner_assert_eq(r, pkg::http_is_redirect(301), 1, "301 is redirect")
    runner_assert_eq(r, pkg::http_is_redirect(308), 1, "308 is redirect")
    runner_assert_eq(r, pkg::http_is_redirect(200), 0, "200 is not redirect")
    runner_assert_eq(r, pkg::http_is_redirect(404), 0, "404 is not redirect")

    # ═══════════════════════════════════════════════════════════
    # 14. Retry Policy & Query Targets
    # ═══════════════════════════════════════════════════════════
    runner_assert_eq(r, pkg::retry_max_attempts(null), 1, "null config means 1 attempt")
    let rcfg = pkg::new_config(10000, 1024, 3, 0, 1)
    runner_assert_eq(r, pkg::retry_max_attempts(rcfg), 4, "max_retries 3 means 4 attempts")
    runner_assert_eq(r, pkg::retry_backoff_ms(rcfg, 2), 2000, "linear backoff delay*attempt")
    runner_assert_eq(r, pkg::retry_backoff_ms(null, 1), 0, "null config means no backoff")
    runner_assert_eq(r, pkg::http_retryable_error("Connection failed to h:80"), 1, "connect failure is retryable")
    runner_assert_eq(r, pkg::http_retryable_error("HTTP error 503 busy"), 1, "HTTP 5xx is retryable")
    runner_assert_eq(r, pkg::http_retryable_error("HTTP error 404 missing"), 0, "HTTP 4xx is fatal")
    runner_assert_eq(r, pkg::http_retryable_error("Checksum mismatch: x"), 0, "checksum mismatch is fatal")
    runner_assert_eq(r, pkg::http_retryable_error("Too many redirects"), 0, "redirect overflow is fatal")
    runner_assert_eq(r, pkg::ftp_retryable_error("FTP control connection failed to h:21"), 1, "ftp connect failure is retryable")
    runner_assert_eq(r, pkg::ftp_retryable_error("FTP RETR failed [421]: busy"), 1, "ftp 4xx is retryable")
    runner_assert_eq(r, pkg::ftp_retryable_error("FTP RETR failed [550]: missing"), 0, "ftp 5xx is fatal")
    runner_assert_eq(r, pkg::ftp_retryable_error("FTP login failed [530]: denied"), 0, "ftp login failure is fatal")
    let qparsed = pkg::parse_transfer_url("http://h:8080/a?token=123")
    runner_assert_str_eq(r, pkg::http_request_target(qparsed), "/a?token=123", "query string preserved in target")
    let nqparsed = pkg::parse_transfer_url("http://h/a")
    runner_assert_str_eq(r, pkg::http_request_target(nqparsed), "/a", "no query means plain path")

    # Offline failure paths (fast refused localhost, no retry)
    let fast_cfg = pkg::new_config(3000, 1024, 0, 0, 1)
    let http_fail = pkg::http_download_once("http://127.0.0.1:1/x", "temp_http_fail.bin", fast_cfg, null)
    runner_assert_eq(r, http_fail.is_error(), 1, "refused http download is error")
    let up_missing = pkg::http_upload_once("http://127.0.0.1:1/x", "temp_no_such_file.bin", fast_cfg, null)
    runner_assert_eq(r, up_missing.is_error(), 1, "missing upload source is error")
    let ftp_fail = pkg::ftp_download_once("127.0.0.1", 1, "u", "p", "/x", "temp_ftp_fail.bin", fast_cfg, null)
    runner_assert_eq(r, ftp_fail.is_error(), 1, "refused ftp download is error")

    # ═══════════════════════════════════════════════════════════
    # 15. FTP Active Mode & Loopback Sockets
    # ═══════════════════════════════════════════════════════════
    runner_assert_str_eq(r, pkg::ftp_format_port("192.168.1.50", 50069), "192,168,1,50,195,149", "PORT coordinates")
    runner_assert_str_eq(r, pkg::ftp_format_port("not-an-ip", 21), "", "bad ip gives empty PORT")
    runner_assert_str_eq(r, pkg::ftp_format_port("10.0.0.1", 0), "", "bad port gives empty PORT")

    let loop_port: int = 39441
    let loop_ls: int = -1
    while loop_port < 39444
        loop_ls = net::tcp_listen(loop_port)
        if loop_ls >= 0
            break
        end
        loop_port += 1
    end
    if loop_ls >= 0
        let loop_cli: int = net::tcp_connect("127.0.0.1", loop_port)
        runner_assert_eq(r, loop_cli >= 0, true, "loopback connect succeeds")
        let loop_srv: int = net::tcp_accept(loop_ls)
        runner_assert_eq(r, loop_srv >= 0, true, "loopback accept succeeds")
        net::tcp_send(loop_cli, "ping")
        runner_assert_str_eq(r, net::tcp_recv(loop_srv, 4), "ping", "loopback cli->srv works")
        net::tcp_send(loop_srv, "pong")
        runner_assert_str_eq(r, net::tcp_recv(loop_cli, 4), "pong", "loopback srv->cli works")
        net::tcp_close(loop_cli)
        net::tcp_close(loop_srv)
        net::tcp_close(loop_ls)
    end

    # ═══════════════════════════════════════════════════════════
    # 16. SFTP Response Codes, Builders & Parsing
    # ═══════════════════════════════════════════════════════════
    runner_assert_eq(r, pkg::SftpType.Status, 101, "SftpType.Status is 101")
    runner_assert_eq(r, pkg::SftpType.Handle, 102, "SftpType.Handle is 102")
    runner_assert_eq(r, pkg::SftpType.Data, 103, "SftpType.Data is 103")
    runner_assert_eq(r, pkg::SftpStatus.Ok, 0, "SftpStatus.Ok is 0")
    runner_assert_eq(r, pkg::SftpStatus.Eof, 1, "SftpStatus.Eof is 1")

    let ver_pkt = pkg::sftp_build_version(3)
    runner_assert_eq(r, pkg::sftp_parse_version(ver_pkt), 3, "version packet parses to 3")
    runner_assert_eq(r, pkg::sftp_parse_version(sftp_init), -1, "INIT packet is not a version")

    let h_pkt = pkg::sftp_build_handle(7, "handle-9")
    runner_assert_eq(r, h_pkt.packet_type, pkg::SftpType.Handle, "handle packet type")
    runner_assert_str_eq(r, pkg::sftp_parse_handle(h_pkt), "handle-9", "handle roundtrip")

    let d_pkt = pkg::sftp_build_data(8, "payload-bytes")
    runner_assert_eq(r, d_pkt.packet_type, pkg::SftpType.Data, "data packet type")
    runner_assert_str_eq(r, pkg::sftp_parse_data(d_pkt), "payload-bytes", "data roundtrip")

    let st_pkt = pkg::sftp_build_status(9, 2, "no such file")
    let st_parsed = pkg::sftp_parse_status(st_pkt)
    runner_assert_eq(r, st_parsed["code"], 2, "status code roundtrip")
    runner_assert_str_eq(r, st_parsed["message"], "no such file", "status message roundtrip")

    # ═══════════════════════════════════════════════════════════
    # 17. SFTP Loopback Download / Upload / Resume
    # ═══════════════════════════════════════════════════════════
    t_files["/remote/data.bin"] = "Hello SFTP loopback world! 0123456789"
    let sftp_cfg = pkg::new_config(5000, 8, 0, 0, 1)

    let dl_file = "temp_sftp_dl.bin"
    let dl_res = pkg::sftp_download_file(t_fake_send, t_fake_recv, "/remote/data.bin", dl_file, sftp_cfg, null)
    runner_assert_eq(r, dl_res.is_ok(), 1, "sftp loopback download ok")
    runner_assert_str_eq(r, read_file(dl_file), t_files["/remote/data.bin"], "sftp download content matches")

    # Resume: truncate local to a prefix, download again, expect full file.
    write_file(dl_file, "Hello SFTP")
    let re_res = pkg::sftp_download_file(t_fake_send, t_fake_recv, "/remote/data.bin", dl_file, sftp_cfg, null)
    runner_assert_eq(r, re_res.is_ok(), 1, "sftp resume download ok")
    runner_assert_str_eq(r, read_file(dl_file), t_files["/remote/data.bin"], "sftp resumed content matches")
    remove_file(dl_file)

    let up_src = "temp_sftp_up_src.bin"
    write_file(up_src, "upload payload 12345")
    let up_res = pkg::sftp_upload_file(t_fake_send, t_fake_recv, up_src, "/remote/up.bin", sftp_cfg, null)
    runner_assert_eq(r, up_res.is_ok(), 1, "sftp loopback upload ok")
    runner_assert_str_eq(r, t_files["/remote/up.bin"], "upload payload 12345", "sftp uploaded content matches")
    remove_file(up_src)

    let miss_res = pkg::sftp_download_file(t_fake_send, t_fake_recv, "/remote/missing.bin", "temp_sftp_miss.bin", sftp_cfg, null)
    runner_assert_eq(r, miss_res.is_error(), 1, "sftp missing file is error")
    runner_assert_eq(r, miss_res.bytes_transferred, 0, "sftp missing file transfers 0")

    # ═══════════════════════════════════════════════════════════
    # 18. Secure-Gated Error Paths (offline-safe in every config)
    # ═══════════════════════════════════════════════════════════
    let https_fail = pkg::https_download_once("https://127.0.0.1:1/x", "temp_https_fail.bin", fast_cfg, null)
    runner_assert_eq(r, https_fail.is_error(), 1, "https without peer is error")
    let ftps_fail = pkg::ftps_download_file("127.0.0.1", 1, "u", "p", "/x", "temp_ftps_fail.bin", fast_cfg, null)
    runner_assert_eq(r, ftps_fail.is_error(), 1, "ftps without peer is error")
    let sftp_url_res = pkg::download("sftp://h/x", "temp_sftp_url.bin").execute()
    runner_assert_eq(r, sftp_url_res.is_error(), 1, "sftp:// builder needs a transport")

    # FTPS active-mode guard (secure builds run the real function here).
    let act_cfg = pkg::new_config(3000, 1024, 0, 0, 1)
    act_cfg.set_ftp_active("10.0.0.5", 40021)
    @cfg(feature = "secure")
    runner_assert_str_eq(r, pkg::ftps_download_once("127.0.0.1", 1, "u", "p", "/x", "temp_ftps_act.bin", act_cfg, null).error_message, "FTPS active mode is not supported (use passive PASV)", "ftps active guard")

    # ═══════════════════════════════════════════════════════════
    # 19. Extended Config & Builder Surface
    # ═══════════════════════════════════════════════════════════
    let cfg2 = pkg::new_config(10000, 1024, 2, 100, 1)
    runner_assert_eq(r, cfg2.ftp_mode, 0, "ftp_mode defaults to passive")
    runner_assert_eq(r, cfg2.ftps, 0, "ftps defaults to off")
    runner_assert_eq(r, cfg2.tls_verify, 1, "tls_verify defaults to on")
    cfg2.set_ftp_active("10.0.0.5", 40021)
    runner_assert_eq(r, cfg2.ftp_mode, 1, "set_ftp_active enables active")
    runner_assert_str_eq(r, cfg2.ftp_active_ip, "10.0.0.5", "active ip stored")
    runner_assert_eq(r, cfg2.ftp_active_port, 40021, "active port stored")
    cfg2.set_ftps(1)
    runner_assert_eq(r, cfg2.ftps, 1, "set_ftps enables")
    cfg2.set_tls_verify(0)
    runner_assert_eq(r, cfg2.tls_verify, 0, "set_tls_verify disables")
    runner_assert_eq(r, cfg2.is_valid(), 1, "extended cfg is valid")

    let adv_builder = pkg::download("ftp://h/f.bin", "f.bin")
    .ftp_active("10.0.0.5", 40021)
    .ftps(0)
    .tls_verify(0)
    runner_assert_eq(r, adv_builder.config.ftp_mode, 1, "builder ftp_active sets mode")
    runner_assert_eq(r, adv_builder.config.tls_verify, 0, "builder tls_verify sets flag")

    let failed = runner_summary(r)
    if failed > 0
        say "Some transfer tests failed."
        exit(1)
    end
end
