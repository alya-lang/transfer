    throw "extras feature is disabled (rebuild with default features or --features extras)"
end

## Fallback stub for `format_transfer_banner` when `extras` feature is disabled.
@cfg(not(feature = "extras"))
pub function format_transfer_banner(title: string) -> string
    throw "extras feature is disabled (rebuild with default features or --features extras)"
end
