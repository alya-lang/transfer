## transfer Package Facade & Public API
##
## Part of the Alya Language package ecosystem (https://github.com/alya-lang).
## High-performance multi-protocol file transfer toolkit for Alya:
## HTTP range requests, resumable downloads and uploads, pure RFC 959 FTP,
## SFTP framing, token-bucket throttling, and CRC-32/MD5/SHA-256 checksums.

import "./types.alya"
import "./core/url.alya"
import "./core/checksum.alya"
import "./core/progress.alya"
import "./core/throttle.alya"
import "./core/resume.alya"
import "./core/formatter.alya"
import "./http/range.alya"
import "./http/client.alya"
import "./ftp/protocol.alya"
import "./ftp/client.alya"
import "./sftp/packet.alya"
import "./sftp/protocol.alya"
import "./builder.alya"

@cfg(feature = "extras")
import "./core/extras.alya"

# ───────────────────────────────────────────────────────────────
# Fluent Builder Entry Points
# ───────────────────────────────────────────────────────────────

## Initiates a fluent download builder targeting a destination file path.
pub function download(url: string, dest_path: string) -> TransferBuilder
    return download_builder(url, dest_path)
end

## Initiates a fluent upload builder sourcing data from a local file path.
pub function upload(url: string, src_path: string) -> TransferBuilder
    return upload_builder(url, src_path)
end

# ───────────────────────────────────────────────────────────────
# Direct Transfer APIs
# ───────────────────────────────────────────────────────────────

## Performs a download from a remote URL to a local destination file.
pub function download_file(url: string, dest_path: string, config: TransferConfig = null, on_progress = null) -> TransferResult
    let b = download_builder(url, dest_path)
    if config is not null
        b.config = config
    end
    b.progress_callback = on_progress
    return b.execute()
end

## Performs an upload from a local file path to a remote URL.
pub function upload_file(url: string, src_path: string, config: TransferConfig = null, on_progress = null) -> TransferResult
    let b = upload_builder(url, src_path)
    if config is not null
        b.config = config
    end
    b.progress_callback = on_progress
    return b.execute()
end

## Performs an FTP file download with optional offset restart (REST) for resume.
pub function ftp_download(host: string, port: int, user: string, pass: string, remote_path: string, local_path: string, resume: int = 1, on_progress = null) -> TransferResult
    return ftp_download_file(host, port, user, pass, remote_path, local_path, resume, on_progress)
end

## Performs an FTP file upload with optional append mode (APPE) for resume.
pub function ftp_upload(host: string, port: int, user: string, pass: string, local_path: string, remote_path: string, resume: int = 0, on_progress = null) -> TransferResult
    return ftp_upload_file(host, port, user, pass, local_path, remote_path, resume, on_progress)
end

# ───────────────────────────────────────────────────────────────
# Configuration & Model Constructors
# ───────────────────────────────────────────────────────────────

## Creates a default `TransferConfig` instance.
pub function new_config(timeout_ms: int = 15000, chunk_size: int = 65536, max_retries: int = 3, rate_limit_bps: int = 0, resumable: int = 1) -> TransferConfig
    return make_config(timeout_ms, chunk_size, max_retries, 1000, rate_limit_bps, resumable, 0)
end

## Creates a default `TransferProgress` metric record.
pub function new_progress(bytes_transferred: int = 0, total_bytes: int = -1, speed_bps: int = 0) -> TransferProgress
    return make_progress(bytes_transferred, total_bytes, speed_bps, 0, 0)
end

# ───────────────────────────────────────────────────────────────
# Integrity Checksum Helpers
# ───────────────────────────────────────────────────────────────

## Computes the CRC-32 checksum string of data.
pub function crc32(data: string) -> string
    return crc32_hex(data)
end

## Computes the MD5 hex digest of data.
pub function md5(data: string) -> string
    return md5_hex(data)
end

## Computes the SHA-256 hex digest of data.
pub function sha256(data: string) -> string
    return sha256_hex(data)
end

## Verifies whether the checksum of a file matches expected hash.
pub function verify_checksum(path: string, expected: string, algo: int = ChecksumAlgo.Sha256) -> int
    return verify_file_checksum(path, expected, algo)
end

