    throw "extras feature is disabled (rebuild with default features or --features extras)"
end

## Fallback stub for `https_download_once` when `secure` feature is disabled.
@cfg(not(feature = "secure"))
pub function https_download_once(url_str: string, dest_path: string, cfg: TransferConfig, on_progress = null, max_hops: int = 5) -> TransferResult
    return error_result(dest_path, "HTTPS URL requires the `secure` feature (rebuild with --features secure): " + url_str)
end

