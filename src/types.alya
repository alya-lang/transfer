## Transfer Types & Data Models
##
## Part of the Alya Language package ecosystem (https://github.com/alya-lang).
## Defines transfer protocols, lifecycle states, configuration models, progress
## tracking metrics, and structural interfaces for multi-protocol transfers.

# ───────────────────────────────────────────────────────────────
# Structural Interfaces (Duck Typing)
# ───────────────────────────────────────────────────────────────

## Public interface for objects capable of producing a formatted string summary.
pub interface Summarizable
    function summary(self) -> string
end

## Public interface for objects that provide detailed status descriptions and validation.
pub interface Describable
    function describe(self) -> string
    function is_valid(self) -> int
end

# ───────────────────────────────────────────────────────────────
# Enumerations
# ───────────────────────────────────────────────────────────────

## Supported transfer protocols.
pub enum TransferProtocol
    Http = 0,
    Https = 1,
    Ftp = 2,
    Sftp = 3,
    File = 4
end

## Transfer direction mode (download vs upload).
pub enum TransferMode
    Download = 0,
    Upload = 1
end

## Lifecycle execution state of a transfer task.
pub enum TransferStatus
    Idle = 0,
    Running = 1,
    Paused = 2,
    Completed = 3,
    Failed = 4,
    Canceled = 5
end

## Cryptographic and integrity checksum algorithms.
pub enum ChecksumAlgo
    None = 0,
    Sha256 = 1,
    Md5 = 2,
    Crc32 = 3
end

# ───────────────────────────────────────────────────────────────
# Data Models (Structs)
# ───────────────────────────────────────────────────────────────

## Configuration data model holding execution parameters and metadata.
##
## Encapsulates timeouts, chunk sizing, concurrency, bandwidth limits,
## retry policy, resume flags, checksum verification, and credentials.
pub struct TransferConfig
    timeout_ms: int,
    chunk_size: int,
    max_retries: int,
    retry_delay_ms: int,
    rate_limit_bps: int,
    resumable: int,
    overwrite: int,
    checksum_algo: int,
    expected_checksum: string,
    auth_user: string,
    auth_pass: string,
    headers: map,
    ftp_mode: int,
    ftps: int,
    tls_verify: int,
    ftp_active_ip: string,
    ftp_active_port: int
end

## Live progress metric reported during an active transfer.
##
## Tracks transferred bytes, total size, throughput speed, elapsed time,
## estimated remaining time (ETA), and completion percentage.
pub struct TransferProgress
    bytes_transferred: int,
    total_bytes: int,
    speed_bps: int,
    elapsed_ms: int,
    eta_seconds: int,
    percent: int
end

## Final outcome container representing the result of a transfer.
##
## Encapsulates success flag, final status, transferred byte count,
## destination file path, computed checksum, error diagnostics, and duration.
pub struct TransferResult
    success: int,
    status: int,
    bytes_transferred: int,
    total_bytes: int,
    file_path: string,
    checksum: string,
    error_message: string,
    elapsed_ms: int
end

## Resumable transfer state token saved to a `.transfer_meta` file.
##
## Allows interrupted transfers to resume from the exact byte offset
## without re-downloading or re-uploading completed chunks.
pub struct ResumeMeta
    url: string,
    dest_path: string,
    total_bytes: int,
    transferred_bytes: int,
    etag: string,
    chunk_size: int,
    created_at: int
end

## FTP server response line containing reply code and status text.
pub struct FtpResponse
    code: int,
    message: string
end

## SFTP binary packet container.
pub struct SftpPacket
    packet_type: int,
    request_id: int,
    payload: string,
    payload_bytes: array
end

# ───────────────────────────────────────────────────────────────
# Factory Constructors
# ───────────────────────────────────────────────────────────────

## Creates a new default `TransferConfig` instance.
pub function make_config(timeout_ms: int = 15000, chunk_size: int = 65536, max_retries: int = 3, retry_delay_ms: int = 1000, rate_limit_bps: int = 0, resumable: int = 1, overwrite: int = 0, ftp_mode: int = 0, ftps: int = 0, tls_verify: int = 1, ftp_active_ip: string = "", ftp_active_port: int = 0) -> TransferConfig
    let limit: int = rate_limit_bps
    if limit < 0
        limit = 0
    end
    let mode: int = ftp_mode
    if mode != 0 and mode != 1
        mode = 0
    end
    let secure_ftp: int = ftps
    if secure_ftp != 0 and secure_ftp != 1
        secure_ftp = 0
    end
    let verify: int = tls_verify
    if verify != 0 and verify != 1
        verify = 1
    end
    return TransferConfig {
        timeout_ms: timeout_ms,
        chunk_size: chunk_size,
        max_retries: max_retries,
        retry_delay_ms: retry_delay_ms,
        rate_limit_bps: limit,
        resumable: resumable,
        overwrite: overwrite,
        checksum_algo: ChecksumAlgo.None,
        expected_checksum: "",
        auth_user: "",
        auth_pass: "",
        headers: {},
        ftp_mode: mode,
        ftps: secure_ftp,
        tls_verify: verify,
        ftp_active_ip: ftp_active_ip,
        ftp_active_port: ftp_active_port
    }
end

## Creates a new `TransferProgress` snapshot.
pub function make_progress(bytes_transferred: int = 0, total_bytes: int = -1, speed_bps: int = 0, elapsed_ms: int = 0, eta_seconds: int = 0) -> TransferProgress
    let pct: int = 0
    if total_bytes > 0
        pct = (bytes_transferred * 100) / total_bytes
        if pct > 100
            pct = 100
        end
    end
    return TransferProgress {
        bytes_transferred: bytes_transferred,
        total_bytes: total_bytes,
        speed_bps: speed_bps,
        elapsed_ms: elapsed_ms,
        eta_seconds: eta_seconds,
        percent: pct
    }
end

## Creates a successful `TransferResult` instance.
pub function ok_result(file_path: string, bytes_transferred: int, total_bytes: int = -1, checksum: string = "", elapsed_ms: int = 0) -> TransferResult
    let tot: int = total_bytes
    if tot < 0
        tot = bytes_transferred
    end
    return TransferResult {
        success: 1,
        status: TransferStatus.Completed,
        bytes_transferred: bytes_transferred,
        total_bytes: tot,
        file_path: file_path,
        checksum: checksum,
        error_message: "",
        elapsed_ms: elapsed_ms
    }
end

## Creates an error `TransferResult` instance.
pub function error_result(file_path: string, error_message: string, bytes_transferred: int = 0, elapsed_ms: int = 0) -> TransferResult
    return TransferResult {
        success: 0,
        status: TransferStatus.Failed,
        bytes_transferred: bytes_transferred,
        total_bytes: 0,
        file_path: file_path,
        checksum: "",
        error_message: error_message,
        elapsed_ms: elapsed_ms
    }
end

## Creates a new `ResumeMeta` instance for tracking resume state.
pub function make_resume_meta(url: string, dest_path: string, total_bytes: int, transferred_bytes: int, etag: string = "", chunk_size: int = 65536) -> ResumeMeta
    return ResumeMeta {
        url: url,
        dest_path: dest_path,
        total_bytes: total_bytes,
        transferred_bytes: transferred_bytes,
        etag: etag,
        chunk_size: chunk_size,
        created_at: 0
    }
end

# ───────────────────────────────────────────────────────────────
# Struct Methods: TransferConfig
# ───────────────────────────────────────────────────────────────

## Returns a formatted single-line string summary of this configuration.
pub function TransferConfig.summary(self: TransferConfig) -> string
    let res_str = when self.resumable
        is 1 => "resumable"
        else => "non-resumable"
    end
    return "TransferConfig(timeout={self.timeout_ms}ms, chunk={self.chunk_size}B, {res_str})"
end

## Returns a detailed multi-attribute description of this configuration.
pub function TransferConfig.describe(self: TransferConfig) -> string
    return "[TransferConfig] timeout={self.timeout_ms}ms, chunk_size={self.chunk_size}, retries={self.max_retries}, rate_limit={self.rate_limit_bps}bps"
end

## Validates whether this configuration conforms to essential operational constraints.
pub function TransferConfig.is_valid(self: TransferConfig) -> int
    if self.timeout_ms <= 0 or self.chunk_size <= 0
        return 0
    end
    if self.rate_limit_bps < 0
        return 0
    end
    if self.max_retries < 0 or self.retry_delay_ms < 0
        return 0
    end
    if self.ftp_mode != 0 and self.ftp_mode != 1
        return 0
    end
    if self.ftps != 0 and self.ftps != 1
        return 0
    end
    if self.tls_verify != 0 and self.tls_verify != 1
        return 0
    end
    return 1
end

## Sets the bandwidth throttle rate limit in bytes per second (0 = unlimited).
pub function TransferConfig.set_rate_limit(self: TransferConfig, bps: int) -> TransferConfig
    if bps < 0
        self.rate_limit_bps = 0
    else
        self.rate_limit_bps = bps
    end
    return self
end

## Sets the FTP data connection mode (0 = passive PASV, 1 = active PORT).
pub function TransferConfig.set_ftp_mode(self: TransferConfig, mode: int) -> TransferConfig
    if mode == 1
        self.ftp_mode = 1
    else
        self.ftp_mode = 0
    end
    return self
end

## Enables (1) or disables (0) explicit FTPS (AUTH TLS) for FTP transfers.
pub function TransferConfig.set_ftps(self: TransferConfig, enabled: int) -> TransferConfig
    if enabled == 1
        self.ftps = 1
    else
        self.ftps = 0
    end
    return self
end

## Enables (1) or disables (0) TLS certificate verification for HTTPS/FTPS.
pub function TransferConfig.set_tls_verify(self: TransferConfig, enabled: int) -> TransferConfig
    if enabled == 0
        self.tls_verify = 0
    else
        self.tls_verify = 1
    end
    return self
end

## Sets the advertised address for FTP active mode (server connects back here).
pub function TransferConfig.set_ftp_active(self: TransferConfig, ip: string, port: int) -> TransferConfig
    self.ftp_mode = 1
    self.ftp_active_ip = ip
    self.ftp_active_port = port
    return self
end

## Sets a custom HTTP request header on this configuration.
pub function TransferConfig.set_header(self: TransferConfig, key: string, val: string) -> TransferConfig
    self.headers[key] = val
    return self
end

## Sets basic authentication credentials on this configuration.
pub function TransferConfig.set_auth(self: TransferConfig, user: string, pass: string) -> TransferConfig
    self.auth_user = user
    self.auth_pass = pass
    return self
end

## Sets expected checksum verification on this configuration.
pub function TransferConfig.set_checksum(self: TransferConfig, algo: int, expected: string) -> TransferConfig
    self.checksum_algo = algo
    self.expected_checksum = expected
    return self
end

# ───────────────────────────────────────────────────────────────
# Struct Methods: TransferProgress
# ───────────────────────────────────────────────────────────────

## Formats the live progress into a human-readable summary.
pub function TransferProgress.summary(self: TransferProgress) -> string
    return "{self.percent}% ({self.bytes_transferred}/{self.total_bytes} bytes)"
end

## Returns 1 if the progress indicates full completion.
pub function TransferProgress.is_complete(self: TransferProgress) -> int
    if self.total_bytes > 0 and self.bytes_transferred >= self.total_bytes
        return 1
    end
    if self.percent >= 100
        return 1
    end
    return 0
end

## Renders a textual progress bar for terminal display.
pub function TransferProgress.render_bar(self: TransferProgress, width: int = 30) -> string
    if width <= 0
        width = 20
    end
    let filled: int = (self.percent * width) / 100
    if filled > width
        filled = width
    end
    let bar: string = "["
    let i: int = 0
    while i < filled
        bar += "="
        i += 1
    end
    if filled < width
        bar += ">"
        let j: int = filled + 1
        while j < width
            bar += " "
            j += 1
        end
    end
    bar += "] " + str(self.percent) + "%"
    return bar
end

# ───────────────────────────────────────────────────────────────
# Struct Methods: TransferResult
# ───────────────────────────────────────────────────────────────

## Returns 1 if this result represents a successful transfer.
pub function TransferResult.is_ok(self: TransferResult) -> int
    if self.success == 1 and self.status == TransferStatus.Completed
        return 1
    end
    return 0
end

## Returns 1 if this result represents a failed transfer.
pub function TransferResult.is_error(self: TransferResult) -> int
    if self.success == 0 or self.status == TransferStatus.Failed
        return 1
    end
    return 0
end

## Returns a formatted single-line string summary of this result.
pub function TransferResult.summary(self: TransferResult) -> string
    if self.success == 1
        return "TransferResult(OK, path='{self.file_path}', bytes={self.bytes_transferred}, elapsed={self.elapsed_ms}ms)"
    end
    return "TransferResult(FAILED, path='{self.file_path}', error='{self.error_message}')"
end

# ───────────────────────────────────────────────────────────────
# Struct Methods: ResumeMeta
# ───────────────────────────────────────────────────────────────

## Validates whether this resume meta contains coherent non-empty parameters.
pub function ResumeMeta.is_valid(self: ResumeMeta) -> int
    if self.url == "" or self.dest_path == "" or self.transferred_bytes < 0
        return 0
    end
    return 1
end

# ───────────────────────────────────────────────────────────────
# Struct Methods: FtpResponse
# ───────────────────────────────────────────────────────────────

## Returns 1 if the FTP response represents a successful completion (2xx).
pub function FtpResponse.is_success(self: FtpResponse) -> int
    if self.code >= 200 and self.code < 300
        return 1
    end
    return 0
end

## Returns 1 if the FTP response represents preliminary positive status (1xx).
pub function FtpResponse.is_preliminary(self: FtpResponse) -> int
    if self.code >= 100 and self.code < 200
        return 1
    end
    return 0
end

## Returns 1 if the FTP response represents an error code (4xx or 5xx).
pub function FtpResponse.is_error(self: FtpResponse) -> int
    if self.code >= 400
        return 1
    end
    return 0
end

# ───────────────────────────────────────────────────────────────
# Struct Methods: SftpPacket
# ───────────────────────────────────────────────────────────────

## Returns the byte length of the payload in this SFTP packet.
pub function SftpPacket.length(self: SftpPacket) -> int
    return len(self.payload)
end

## Returns a formatted summary of this SFTP packet.
pub function SftpPacket.summary(self: SftpPacket) -> string
    return "SftpPacket(type={self.packet_type}, id={self.request_id}, len={len(self.payload)})"
end
