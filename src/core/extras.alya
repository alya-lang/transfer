## transfer Optional Extras Module (feature-gated)
##
## Part of the Alya Language package ecosystem (https://github.com/alya-lang).
## Advanced transfer utilities, multipart chunk planning, and diagnostic tools.

## Computes byte offset ranges for dividing a file into N balanced multipart chunks.
##
## ### Parameters
## - `total_bytes`: Total byte size of the target file.
## - `chunk_count`: Desired number of parallel/sequential chunks (>= 1).
##
## ### Returns
## Array of chunk maps, each containing: `index`, `start`, `end`, `size`.
@cfg(feature = "extras")
pub function plan_multipart_chunks(total_bytes: int, chunk_count: int = 4) -> array
    let chunks = []
    if total_bytes <= 0 or chunk_count <= 0
        return chunks
    end

    let count: int = chunk_count
    if count > total_bytes
        count = total_bytes
    end

    let base_chunk_size: int = total_bytes / count
    let remainder: int = total_bytes % count

    let current_offset: int = 0
    let i: int = 0
    while i < count
        let this_size: int = base_chunk_size
        if i == count - 1
            this_size += remainder
        end
        let end_offset: int = current_offset + this_size - 1

        chunks.push({
            "index": i,
            "start": current_offset,
            "end": end_offset,
            "size": this_size
        })

        current_offset += this_size
        i += 1
    end

    return chunks
end

## Generates a decorative terminal banner for file transfer operations.
@cfg(feature = "extras")
pub function format_transfer_banner(title: string) -> string
    let line: string = "════════════════════════════════════════════════════════════"
    return line + "\n  " + title + "\n" + line
end
