## Transfer Presentation & Formatting Helpers
##
## Part of the Alya Language package ecosystem (https://github.com/alya-lang).
## Formats transfer progress, speed, file sizes, and status summaries.

import "../types.alya"
import "./progress.alya"

## Formats bytes into a human-readable size string (B, KB, MB, GB).
pub function format_size(bytes_count: int) -> string
    return format_byte_size(bytes_count)
end

## Formats throughput into a human-readable speed string (e.g. "1.5 MB/s").
pub function format_speed(bps: int) -> string
    if bps <= 0
        return "0 B/s"
    end
    return format_byte_size(bps) + "/s"
end

## Formats duration in seconds into HH:MM:SS or MM:SS.
pub function format_time(seconds: int) -> string
    return format_transfer_duration(seconds)
end

## Formats a `TransferProgress` snapshot into a full visual summary line.
pub function format_progress(prog: TransferProgress) -> string
    let bar = prog.render_bar(25)
    let spd = format_speed(prog.speed_bps)
    let bytes_str = format_size(prog.bytes_transferred)
    let tot_str = "?"
    if prog.total_bytes > 0
        tot_str = format_size(prog.total_bytes)
    end
    return f"{bar} {bytes_str}/{tot_str} ({spd})"
end

## Formats a `TransferResult` into an outcome string.
pub function format_result(result: TransferResult) -> string
    if result.is_ok() == true
        return f"[OK] Transferred {format_size(result.bytes_transferred)} to '{result.file_path}'"
    end
    return f"[ERROR] Transfer failed for '{result.file_path}': {result.error_message}"
end

## Formats a `TransferConfig` into a summary string.
pub function format_config(cfg: TransferConfig) -> string
    return cfg.summary()
end
