## Runnable showcase and demonstration for transfer
## Part of the Alya Language package ecosystem (https://github.com/alya-lang)

import "../src/lib.alya" as pkg

function main()
    say "=== Alya transfer Package Showcase ==="
    say ""

    # ───────────────────────────────────────────────────────────
    # 1. Fluent TransferBuilder Construction
    # ───────────────────────────────────────────────────────────
    say "--- 1. Fluent TransferBuilder ---"
    let dl = pkg::download("https://speed.hetzner.de/100MB.bin", "100MB.bin")
    .timeout(20000)
    .chunk_size(65536)
    .rate_limit(5242880) # 5 MB/s
    .resumable(1)
    .auth("user", "token_xyz")
    .header("User-Agent", "Custom-Alya-Agent/1.0")
    .verify_sha256("2cf24dba5fb0a30e26e83b2ac5b9e29e1b161e5c1fa7425e73043362938b9824")

    say "Download target URL:  " + dl.url
    say "Destination path:     " + dl.file_path
    say "Timeout setting:      " + str(dl.config.timeout_ms) + " ms"
    say "Chunk buffer:         " + pkg::format_size(dl.config.chunk_size)
    say "Bandwidth limit:      " + pkg::format_speed(dl.config.rate_limit_bps)
    say "Summary:              " + dl.config.summary()
    say ""

    # ───────────────────────────────────────────────────────────
    # 2. Progress Tracking & Visual Bar Rendering
    # ───────────────────────────────────────────────────────────
    say "--- 2. Live Progress Tracking & Visual Bar ---"
    let prog1 = pkg::new_progress(1048576, 10485760, 524288) # 10%
    let prog2 = pkg::new_progress(5242880, 10485760, 1048576) # 50%
    let prog3 = pkg::new_progress(10485760, 10485760, 2097152) # 100%

    say "10% Progress:  " + pkg::format_progress(prog1)
    say "50% Progress:  " + pkg::format_progress(prog2)
    say "100% Progress: " + pkg::format_progress(prog3)
    say "Formatted byte sizes: 512 B, " + pkg::format_size(1572864) + ", " + pkg::format_size(5368709120)
    say "Formatted duration:   " + pkg::format_time(125) + ", " + pkg::format_time(3670)
    say ""

    # ───────────────────────────────────────────────────────────
    # 3. HTTP Range Requests & Content-Range Headers
    # ───────────────────────────────────────────────────────────
    say "--- 3. HTTP Range Header Processing ---"
    let open_range = pkg::build_range_header(1048576)
    let closed_range = pkg::build_range_header(0, 4095)
    say "Open-ended range:   " + open_range
    say "Closed byte range:  " + closed_range

    let cr = pkg::parse_content_range("bytes 1048576-2097151/10485760")
    say "Content-Range valid: " + str(cr["valid"])
    say "Range Start:         " + str(cr["start"])
    say "Range End:           " + str(cr["end"])
    say "Total File Size:     " + pkg::format_size(cr["total"])
    say ""

    # ───────────────────────────────────────────────────────────
    # 4. Multi-Protocol URL Parsing
    # ───────────────────────────────────────────────────────────
    say "--- 4. Multi-Protocol URL Parsing ---"
    let ftp_url = pkg::parse_transfer_url("ftp://operator:secret@ftp.server.org:2121/backups/db.tar.gz")
    say "FTP Scheme:   " + ftp_url["scheme"]
    say "FTP Host:     " + ftp_url["host"]
    say "FTP Port:     " + str(ftp_url["port"])
    say "FTP User:     " + ftp_url["user"]
    say "FTP Path:     " + ftp_url["path"]
    say "Filename:     " + pkg::extract_url_filename(ftp_url["path"])
    say ""

    # ───────────────────────────────────────────────────────────
    # 5. Cryptographic & Data Integrity Checksums
    # ───────────────────────────────────────────────────────────
    say "--- 5. Data Integrity Checksums ---"
    let sample = "The quick brown fox jumps over the lazy dog"
    let crc = pkg::crc32(sample)
    let md5_hash = pkg::md5(sample)
    let sha_hash = pkg::sha256(sample)

    say "CRC-32:  " + crc
    say "MD5:     " + md5_hash
    say "SHA-256: " + sha_hash
    say ""

    # ───────────────────────────────────────────────────────────
    # 6. RFC 959 FTP Passive Mode Decoding
    # ───────────────────────────────────────────────────────────
    say "--- 6. FTP Passive Mode (PASV) Decoding ---"
    let pasv_line = "227 Entering Passive Mode (192,168,1,100,195,149)"
    let pasv = pkg::ftp_parse_pasv(pasv_line)
    say "PASV Raw:   " + pasv_line
    say "Data IP:    " + pasv["ip"]
    say "Data Port:  " + str(pasv["port"])
    say "Command:    " + trim(pkg::ftp_format_command("RETR", "/files/doc.pdf"))
    say ""

    # ───────────────────────────────────────────────────────────
    # 7. SFTP Binary Packet Framing (v3)
    # ───────────────────────────────────────────────────────────
    say "--- 7. SFTP Binary Packet Framing ---"
    let open_pkt = pkg::sftp_build_open(1, "/var/log/syslog", pkg::SftpOpenFlags.Read)
    say "SFTP Packet Type: " + str(open_pkt.packet_type)
    say "SFTP Request ID:  " + str(open_pkt.request_id)
    say "SFTP Wire Bytes:  " + str(len(open_pkt.payload_bytes)) + " bytes"
    say ""

    # ───────────────────────────────────────────────────────────
    # 8. Feature-Gated Multipart Chunk Planning
    # ───────────────────────────────────────────────────────────
    say "--- 8. Feature-Gated Extras ---"
    @cfg(feature = "extras")
    let banner = pkg::format_transfer_banner("Multipart Transfer Engine")
    say banner
    let chunks = pkg::plan_multipart_chunks(1000000, 4)
    say "Planned 4 chunks for 1,000,000 bytes:"
    let ci = 0
    while ci < len(chunks)
        let ch = chunks[ci]
        say "  Chunk " + str(ch["index"]) + ": offset " + str(ch["start"]) + " .. " + str(ch["end"]) + " (" + pkg::format_size(ch["size"]) + ")"
        ci += 1
    end
    @cfg(not(feature = "extras"))
    say "(Extras feature disabled)"

    say ""
    say "=== transfer Demo Completed Successfully ==="
end

main()
